# Klyval environment template — names and placeholders only, NEVER real values.
# Copy to .env for local development; PHP prefers real environment variables over this file.

# Application
APP_ENV=local            # local | staging | production
APP_DEBUG=1              # MUST be 0 (or unset) on any public URL
APP_URL=http://localhost:3000   # final public https URL in production, no trailing slash
APP_TZ=UTC               # keep UTC; data migration assumes UTC
# APP_KEY=               # REQUIRED in production: 32+ random bytes (e.g. `openssl rand -hex 32`). App fails closed without it.
TRUSTED_PROXY=0          # 1 only after verifying the platform's forwarded headers (see docs/DEPLOY.md)

# Database (PostgreSQL / Supabase on the target platform)
DB_HOST=
DB_PORT=6543             # 6543 = transaction-mode pooler (runtime), 5432 = session pooler / direct (CLI, migrations)
DB_NAME=
DB_USER=
DB_PASS=
DB_SSLMODE=require       # keep `require` for Supabase

# Contact form fallback (optional; site settings take precedence)
CONTACT_EMAIL=

# Supabase Storage (SERVER-side only. Never expose the service key to browsers/JS.)
SUPABASE_URL=            # https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=media
MEDIA_BASE_URL=          # optional: override public media URL origin (CDN/custom domain)
